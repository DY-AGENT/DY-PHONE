{
  "name": "dy-phone",
  "version": "3.19.0",
  "description": "DY PHONE — an Android AI assistant with on-device model integration and an in-app workspace.",
  "license": "MIT",
  "scripts": {
    "build": "echo 'Static web assets — no bundling step'",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/device": "^6.0.3",
    "@capacitor/filesystem": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1"
  }
}
